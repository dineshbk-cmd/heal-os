# Copy to .env (local) or add in Netlify → Site configuration → Environment variables.
# Leave empty to run in DEMO mode (data stays in this browser only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (Netlify function for "sign in with mobile number").
# Never prefix with VITE_ — it must not reach the browser.
SUPABASE_SERVICE_ROLE_KEY=
